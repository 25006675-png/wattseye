# Meta WhatsApp Cloud API credentials
# From developers.facebook.com → your app → WhatsApp → API Setup
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=000000000000000
META_RECIPIENT=60xxxxxxxxx

# Webhook verification token — any string you choose; paste the SAME value into
# the Meta App dashboard webhook config so the GET handshake matches.
META_VERIFY_TOKEN=choose-any-string

# Gemini API for LLM rephrase of WhatsApp messages (free tier OK)
# Get one from https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSy...

# Language for WhatsApp messages — one of: en | malay | mix
# en    = pure English
# malay = pure Bahasa Malaysia
# mix   = English with light Manglish / Malaysian slang (default)
# WATTSEYE_LANG=mix

# --- Pi hardware calibration (ML/sensing/ads1115_reader.py) ------------------
# Tune these on the Pi against a reference meter (HARDWARE_CONNECTION.md §16) so
# you never edit tracked code to recalibrate. Defaults shown; uncomment to set.
# WATTSEYE_VOLTS_PER_VOLT=240.0     # mains volts per 1 V at ZMPT101B OUT
# WATTSEYE_AMPS_PER_VOLT=30.0       # amps per 1 V at the SCT-013 jack (30A/1V)
# WATTSEYE_CAL_VOLTAGE_SCALE=1.00   # fine trim, voltage channel
# WATTSEYE_CAL_MAIN_SCALE=1.00      # fine trim, whole-home current clamp
# WATTSEYE_CAL_AC_SCALE=1.00        # fine trim, dedicated AC current clamp

# MQTT broker the Pi processes connect to (defaults to localhost on the Pi).
# MQTT_BROKER=127.0.0.1
# MQTT_PORT=1883
